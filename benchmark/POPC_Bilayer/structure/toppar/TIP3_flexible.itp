;; Flexible CHARMM TIP3, derived from the source TIP3.itp (CHARMM-GUI v1.7).
;; The [settles] rigid triangle is replaced with explicit [bonds]/[angles]
;; so the water can be integrated unconstrained. Constants read verbatim
;; from OpenMM's charmm36_2024/water.xml (HT-OT bond, HT-OT-HT angle) --
;; see popc_config.FLEXIBLE_TIP3.

[ moleculetype ]
; name  nrexcl
SOL      2

[ atoms ]
; nr    type    resnr   residu  atom    cgnr    charge  mass
     1         OT      1     SOL    OH2      1     -0.834    15.9994   ; qtot -0.834
     2         HT      1     SOL     H1      2      0.417     1.0080   ; qtot -0.417
     3         HT      1     SOL     H2      3      0.417     1.0080   ; qtot  0.000

[ bonds ]
; i  j  funct  b0 (nm)  kb (kJ/mol/nm^2)
1  2   1  0.09572  376560.0
1  3   1  0.09572  376560.0

[ angles ]
; i  j  k  funct  theta0 (deg)  ktheta (kJ/mol/rad^2)
2  1  3   1  104.52  460.24

[ exclusions ]
1 2 3
2 1 3
3 1 2
